{
  "name": "library-management-api",
  "version": "2.0.0",
  "description": "Library Management REST API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "seed": "tsx src/seed/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "bcryptjs": "^3.0.0",
    "cloudinary": "^2.6.0",
    "dotenv": "^17.4.2",
    "hono": "^4.8.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.16.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
