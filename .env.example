# ─── REQUIRED ───────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-secret-at-least-32-chars
DATABASE_URL=mongodb://127.0.0.1:27017/library-management

# ─── Optional ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@library.com
